# Chặn lệnh xoá và git commit (2026-10-26, chủ repo; CLAUDE.md §3).
# "forbidden" thắng mọi "allow" khác, kể cả khi approval_policy = "never".
prefix_rule(pattern=["rm"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["rmdir"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["unlink"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["shred"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["srm"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["trash"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "rm"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "clean"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "branch", "-d"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "branch", "-D"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "worktree", "remove"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "worktree", "prune"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "stash", "drop"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "stash", "clear"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "push", "--delete"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["docker", "rm"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["docker", "rmi"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["docker", "volume", "rm"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["docker", "system", "prune"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["docker", "compose", "down", "-v"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
prefix_rule(pattern=["git", "commit"], decision="forbidden", justification="Lệnh xoá và git commit do chủ repo tự chạy.")
