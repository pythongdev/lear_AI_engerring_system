diff --git a/be/internal/google/verifier.go b/be/internal/google/verifier.go
new file mode 100644
index 0000000..b6ca382
--- /dev/null
+++ b/be/internal/google/verifier.go
@@ -0,0 +1,171 @@
+// Package google verifies Google ID tokens without third-party JWT dependencies.
+package google
+
+import (
+	"context"
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"io"
+	"math/big"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+type Claims struct{ Sub, Email, Name string }
+type Verifier interface {
+	Verify(context.Context, string) (Claims, error)
+}
+
+var ErrInvalid = errors.New("invalid Google ID token")
+
+const CertsURL = "https://www.googleapis.com/oauth2/v3/certs"
+
+type Options struct {
+	JWKSURL string
+	Now     func() time.Time
+	Client  *http.Client
+}
+type verifier struct {
+	clientID, url string
+	now           func() time.Time
+	client        *http.Client
+	mu            sync.Mutex
+	keys          map[string]*rsa.PublicKey
+	expires       time.Time
+}
+
+func New(clientID string, opts Options) Verifier {
+	if opts.JWKSURL == "" {
+		opts.JWKSURL = CertsURL
+	}
+	if opts.Now == nil {
+		opts.Now = time.Now
+	}
+	if opts.Client == nil {
+		opts.Client = &http.Client{Timeout: 10 * time.Second}
+	}
+	return &verifier{clientID: clientID, url: opts.JWKSURL, now: opts.Now, client: opts.Client}
+}
+func (v *verifier) Verify(ctx context.Context, token string) (Claims, error) {
+	var out Claims
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 || len(token) > 65536 || v.clientID == "" {
+		return out, ErrInvalid
+	}
+	var h struct{ Alg, Kid string }
+	if decode(parts[0], &h) != nil || h.Alg != "RS256" || h.Kid == "" {
+		return out, ErrInvalid
+	}
+	key, err := v.key(ctx, h.Kid)
+	if err != nil {
+		return out, ErrInvalid
+	}
+	signature, err := base64.RawURLEncoding.DecodeString(parts[2])
+	if err != nil {
+		return out, ErrInvalid
+	}
+	digest := sha256.Sum256([]byte(parts[0] + "." + parts[1]))
+	if rsa.VerifyPKCS1v15(key, crypto.SHA256, digest[:], signature) != nil {
+		return out, ErrInvalid
+	}
+	var p struct {
+		Sub, Email, Name, Iss, Aud string
+		Exp                        int64
+		EmailVerified              json.RawMessage `json:"email_verified"`
+	}
+	if decode(parts[1], &p) != nil || p.Aud != v.clientID ||
+		(p.Iss != "accounts.google.com" && p.Iss != "https://accounts.google.com") ||
+		p.Exp <= 0 || p.Exp <= v.now().Unix()-60 || strings.TrimSpace(p.Sub) == "" ||
+		(string(p.EmailVerified) != "true" && string(p.EmailVerified) != `"true"`) {
+		return out, ErrInvalid
+	}
+	return Claims{Sub: p.Sub, Email: p.Email, Name: p.Name}, nil
+}
+func decode(s string, dst any) error {
+	b, err := base64.RawURLEncoding.DecodeString(s)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(b, dst)
+}
+func (v *verifier) key(ctx context.Context, kid string) (*rsa.PublicKey, error) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	refreshed := false
+	if v.keys == nil || !v.now().Before(v.expires) {
+		if err := v.refresh(ctx); err != nil {
+			return nil, err
+		}
+		refreshed = true
+	}
+	if key := v.keys[kid]; key != nil {
+		return key, nil
+	}
+	// A fresh fetch already counts as the one refresh for an unknown kid.
+	if !refreshed {
+		if err := v.refresh(ctx); err != nil {
+			return nil, err
+		}
+	}
+	if key := v.keys[kid]; key != nil {
+		return key, nil
+	}
+	return nil, ErrInvalid
+}
+func (v *verifier) refresh(ctx context.Context) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, v.url, nil)
+	if err != nil {
+		return err
+	}
+	resp, err := v.client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return ErrInvalid
+	}
+	var jwks struct {
+		Keys []struct{ Kty, Kid, Alg, Use, N, E string }
+	}
+	if json.NewDecoder(io.LimitReader(resp.Body, 1<<20)).Decode(&jwks) != nil {
+		return ErrInvalid
+	}
+	keys := make(map[string]*rsa.PublicKey)
+	for _, k := range jwks.Keys {
+		if k.Kty != "RSA" || k.Kid == "" || (k.Alg != "" && k.Alg != "RS256") || (k.Use != "" && k.Use != "sig") {
+			continue
+		}
+		n, en := base64.RawURLEncoding.DecodeString(k.N)
+		e, ee := base64.RawURLEncoding.DecodeString(k.E)
+		if en != nil || ee != nil || len(n) < 256 || len(e) == 0 || len(e) > 4 {
+			continue
+		}
+		exponent := new(big.Int).SetBytes(e).Int64()
+		if exponent < 3 || exponent > 2147483647 || exponent%2 == 0 {
+			continue
+		}
+		keys[k.Kid] = &rsa.PublicKey{N: new(big.Int).SetBytes(n), E: int(exponent)}
+	}
+	if len(keys) == 0 {
+		return ErrInvalid
+	}
+	ttl := int64(0)
+	for _, d := range strings.Split(resp.Header.Get("Cache-Control"), ",") {
+		k, value, ok := strings.Cut(strings.TrimSpace(d), "=")
+		if ok && strings.EqualFold(k, "max-age") {
+			if n, e := strconv.ParseInt(strings.Trim(value, `"`), 10, 32); e == nil && n >= 0 {
+				ttl = n
+			}
+		}
+	}
+	v.keys, v.expires = keys, v.now().Add(time.Duration(ttl)*time.Second)
+	return nil
+}
diff --git a/be/internal/google/verifier_test.go b/be/internal/google/verifier_test.go
new file mode 100644
index 0000000..9d3c516
--- /dev/null
+++ b/be/internal/google/verifier_test.go
@@ -0,0 +1,111 @@
+package google
+
+import (
+	"context"
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestI035_GoogleVerify(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Unix(1800000000, 0)
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		w.Header().Set("Cache-Control", "public, max-age=3600")
+		_ = json.NewEncoder(w).Encode(map[string]any{"keys": []any{map[string]string{
+			"kty": "RSA", "kid": "known", "alg": "RS256", "use": "sig",
+			"n": base64.RawURLEncoding.EncodeToString(key.N.Bytes()), "e": base64.RawURLEncoding.EncodeToString(big.NewInt(int64(key.E)).Bytes()),
+		}}})
+	}))
+	defer server.Close()
+	v := New("client", Options{JWKSURL: server.URL, Now: func() time.Time { return now }})
+	sign := func(h, p map[string]any, k *rsa.PrivateKey) string {
+		t.Helper()
+		hb, _ := json.Marshal(h)
+		pb, _ := json.Marshal(p)
+		raw := base64.RawURLEncoding.EncodeToString(hb) + "." + base64.RawURLEncoding.EncodeToString(pb)
+		sum := sha256.Sum256([]byte(raw))
+		sig, err := rsa.SignPKCS1v15(rand.Reader, k, crypto.SHA256, sum[:])
+		if err != nil {
+			t.Fatal(err)
+		}
+		return raw + "." + base64.RawURLEncoding.EncodeToString(sig)
+	}
+	for _, tc := range []struct {
+		name     string
+		field    string
+		value    any
+		valid    bool
+		wrongKey bool
+	}{
+		{name: "valid", valid: true}, {name: "verified_string", field: "email_verified", value: "true", valid: true},
+		{name: "second_issuer", field: "iss", value: "accounts.google.com", valid: true},
+		{name: "clock_skew", field: "exp", value: now.Unix() - 59, valid: true},
+		{name: "bad_signature", wrongKey: true}, {name: "wrong_alg", field: "alg", value: "HS256"},
+		{name: "unknown_kid", field: "kid", value: "unknown"}, {name: "wrong_aud", field: "aud", value: "elsewhere"},
+		{name: "wrong_iss", field: "iss", value: "https://evil.test"}, {name: "expired", field: "exp", value: now.Unix() - 61},
+		{name: "expiry_boundary", field: "exp", value: now.Unix() - 60}, {name: "missing_exp", field: "exp", value: nil},
+		{name: "unverified", field: "email_verified", value: false}, {name: "empty_sub", field: "sub", value: ""},
+		{name: "blank_sub", field: "sub", value: "   "},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := map[string]any{"alg": "RS256", "kid": "known"}
+			p := map[string]any{"sub": "subject", "email": "guest@gmail.com", "name": "Guest", "iss": "https://accounts.google.com", "aud": "client", "exp": now.Unix() + 600, "email_verified": true}
+			if tc.field == "alg" || tc.field == "kid" {
+				h[tc.field] = tc.value
+			} else if tc.field != "" {
+				p[tc.field] = tc.value
+			}
+			signingKey := key
+			if tc.wrongKey {
+				signingKey = other
+			}
+			before := calls.Load()
+			got, err := v.Verify(context.Background(), sign(h, p, signingKey))
+			if tc.valid {
+				if err != nil || got != (Claims{"subject", "guest@gmail.com", "Guest"}) {
+					t.Fatalf("claims=%+v err=%v", got, err)
+				}
+			} else if err == nil {
+				t.Fatal("accepted invalid token")
+			}
+			if tc.name == "unknown_kid" && calls.Load()-before != 1 {
+				t.Fatalf("unknown kid fetched %d times", calls.Load()-before)
+			}
+			if tc.name == "verified_string" && calls.Load() != before {
+				t.Fatal("ignored max-age cache")
+			}
+		})
+	}
+	t.Run("cache_expired", func(t *testing.T) {
+		now = now.Add(2 * time.Hour)
+		before := calls.Load()
+		_, err := v.Verify(context.Background(), sign(map[string]any{"alg": "RS256", "kid": "known"}, map[string]any{"sub": "s", "aud": "client", "iss": "accounts.google.com", "exp": now.Unix() + 10, "email_verified": true}, key))
+		if err != nil || calls.Load()-before != 1 {
+			t.Fatalf("refresh: %v calls=%d", err, calls.Load()-before)
+		}
+	})
+	for _, token := range []string{"", "a.b", "e30.e30.???"} {
+		if _, err := v.Verify(context.Background(), token); err == nil {
+			t.Fatal("accepted malformed token")
+		}
+	}
+}
